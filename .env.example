NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

NVIDIA_API_KEY=
NVIDIA_KIMI_MODEL=moonshotai/kimi-k3
NVIDIA_RESEARCH_MODEL=z-ai/glm-5.3-flash

# Legacy model variables remain accepted for compatibility. Retired model
# values are ignored and replaced by NVIDIA_RESEARCH_MODEL.
NVIDIA_DEEPSEEK_MODEL=
NVIDIA_MINIMAX_MODEL=

# Admin identity comes from approved Supabase accounts (admin_users table).
# ADMIN_SESSION_SECRET signs the admin session cookie (use at least 32 random bytes).
ADMIN_SESSION_SECRET=
# Optional comma-separated Supabase UIDs allowed to grant/revoke admin and
# settle commissions. When empty, the first approved admin is the owner.
ADMIN_OWNER_UIDS=

# Per-user daily AI usage caps (0 disables a cap).
AI_DAILY_REQUEST_CAP=60
AI_DAILY_TOKEN_CAP=300000

UROPAY_API_KEY=
UROPAY_API_SECRET=
UROPAY_WEBHOOK_SECRET=
UROPAY_ENVIRONMENT=test
# Comma-separated hosts UroPay may serve checkout pages from. The checkout
# URL returned by UroPay is navigated to blindly, so any other host is
# rejected server-side before it reaches the browser.
UROPAY_ALLOWED_HOSTS=api.uropai.in,uropai.in,www.uropai.in,checkout.uropai.in

NEXT_PUBLIC_SITE_URL=https://mun-ai-app.vercel.app
