# Public Supabase app config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend-only Supabase admin key
SUPABASE_SECRET_KEY=

# NVIDIA AI provider
NVIDIA_API_KEY=
NVIDIA_KIMI_MODEL=moonshotai/kimi-k3
NVIDIA_RESEARCH_MODEL=z-ai/glm-5-3-flash

# Free trial — three days of access granted once, automatically, to a new
# account (see supabase/migrations/20261013_free_trial.sql).
# How many days the trial lasts. Bounded 1-30 to match the grant RPC.
AI_FREE_TRIAL_DAYS=3
# Daily token budget for a trialling account. Requests are UNLIMITED during the
# trial (that is the feature); this is the cost ceiling that stops a script
# turning a free account into an unbounded inference bill. A person prepping
# hard for a conference uses well under this, so it binds only on abuse.
AI_TRIAL_DAILY_TOKEN_CAP=1000000

# Admin session auth
# ADMIN_SESSION_SECRET must be at least 32 random bytes
ADMIN_SESSION_SECRET=
# Optional comma-separated Supabase UIDs allowed to act as owner/admin
ADMIN_OWNER_UIDS=

# UroPay payment integration
UROPAY_API_KEY=
UROPAY_API_SECRET=
UROPAY_WEBHOOK_SECRET=
# Comma-separated hosts UroPay checkout pages may be served from.
# Any other host is rejected server-side before the browser sees it.
UROPAY_ALLOWED_HOSTS=api.uropai.in,uropai.in,www.uropai.in,checkout.uropai.in

# Public app origin used by the site
NEXT_PUBLIC_SITE_URL=https://mun-ai-app.vercel.app

# x402 Machine-to-Machine Payments (AI agents & crawler microtransactions)
# Merchant EVM wallet address to receive bot micro-payments (USDC).
# REQUIRED, with no usable default: a missing, malformed, zero, or placeholder
# address now closes the paid routes with a 503 instead of quietly advertising an
# address nobody controls. Replace this with YOUR wallet before enabling x402.
# Example shape: X402_PAY_TO=0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed
X402_PAY_TO=
# Target EVM network: eip155:84532 (Base Sepolia testnet) or eip155:8453 (Base mainnet)
X402_NETWORK=eip155:84532
# Facilitator service URL (defaults to https://x402.org/facilitator)
X402_FACILITATOR_URL=https://x402.org/facilitator

